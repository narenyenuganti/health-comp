SUPABASE_URL =
SUPABASE_PUBLISHABLE_KEY =
HEALTHCOMP_INVITE_HOST = healthcomp.app
HEALTHCOMP_ALLOW_CUSTOM_INVITE_SCHEME = NO
HEALTHCOMP_ENABLE_APPLE_WEB_SIGN_IN = NO
HEALTHCOMP_APPLE_WEB_CLIENT_ID =
HEALTHCOMP_APP_GROUP = group.com.narenyenuganti.HealthComp

// The one place to bump a release. Every target (app, widgets, watch app and
// its widgets) reads these, so their versions can't drift apart. After a
// bump, save what the new build can call: scripts/save-released-api.sh.
// Before distributing it, add the new CURRENT_PROJECT_VERSION to the
// APP_ATTEST_ALLOWED_BUNDLE_VERSIONS secret in staging and production (and 4
// to APP_ATTEST_ALLOWED_VALIDATION_CATEGORIES before the first App Store
// build), or the server refuses its score uploads. See "App Attest policy" in
// docs/runbooks/supabase-environments.md.
MARKETING_VERSION = 1.0.4
CURRENT_PROJECT_VERSION = 4
